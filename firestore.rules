rules_version = '2';

/*
  Lista de Compras — Regras de Segurança (Fase 3)

  O QUE MUDOU E POR QUÊ
  ---------------------
  A regra da Fase 2 era:

      allow read, write: if ownerId is string && ownerId.size() > 0;

  Isso permitia que QUALQUER pessoa com o SDK do Firebase e o projectId
  (que é público por natureza — fica no HTML de todo app Firebase) lesse e
  escrevesse QUALQUER documento: bastava adivinhar o "código de
  sincronização". Códigos legíveis como "familia-silva" são enumeráveis.
  Não era uma senha; era uma porta destrancada com o nome do morador na
  placa. Com um segundo usuário no app, isso vira incidente de LGPD.

  A regra abaixo exige autenticação e amarra o documento ao uid gerado pelo
  Firebase Auth — que o usuário não escolhe e não consegue forjar.

  PUBLICAR: Console do Firebase → Firestore Database → Regras → Publicar.
  Publique DEPOIS de o login estar funcionando, senão o app para de gravar.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // Confere se o payload tem a forma esperada. Não substitui a validação
    // do cliente: serve para impedir que um cliente adulterado grave lixo
    // ou infle o documento até estourar custo de leitura.
    function validPayload() {
      return request.resource.data.keys().hasAll(['state', 'updatedAt'])
          && request.resource.data.state is map
          && request.resource.data.updatedAt is number
          // limite de chaves de primeiro nível do estado. Se algum dia isso
          // apertar, o problema não é a regra: é o modelo monolítico de um
          // documento por usuário, que a Fase 4 substitui.
          && request.resource.data.state.keys().size() < 24;
    }

    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    match /shoppingLists/{ownerId} {

      // Só o dono lê. Sem login, ninguém lê nada.
      allow read: if isOwner(ownerId);

      // Criação: o documento nasce com a forma esperada.
      allow create: if isOwner(ownerId) && validPayload();

      // Atualização: continua sendo o dono e o payload continua válido.
      // Recusamos escrita que "volta no tempo" — updatedAt nunca retrocede,
      // o que barra o replay de um estado antigo.
      allow update: if isOwner(ownerId)
                    && validPayload()
                    && request.resource.data.updatedAt >= resource.data.updatedAt;

      // Exclusão dos próprios dados (portabilidade e direito ao
      // esquecimento — LGPD). Só o dono.
      allow delete: if isOwner(ownerId);
    }

    /* ===================================================================
       BLOCO G — LISTAS COMPARTILHADAS (FAMÍLIAS)
       ===================================================================

       Papéis:
         owner  — tudo, inclusive convidar, mudar papéis e excluir
         editor — mexer nas listas
         viewer — só ler

       O ponto delicado é o ingresso: alguém que AINDA NÃO é membro precisa
       conseguir se acrescentar à família. Se isso ficar solto, qualquer
       pessoa logada entra em qualquer família. A regra abaixo só aceita a
       auto-inclusão quando o servidor confere, por conta própria, que existe
       um convite válido, não expirado, apontando para esta família e com o
       mesmo papel que o cliente está tentando gravar.
    */

    function membros() {
      return resource.data.members;
    }
    function souMembro() {
      return request.auth != null && request.auth.uid in membros();
    }
    function meuPapel() {
      return membros()[request.auth.uid].role;
    }
    function souDono() {
      return souMembro() && meuPapel() == 'owner';
    }
    function possoEditar() {
      return souMembro() && meuPapel() in ['owner', 'editor'];
    }

    // Campos alterados nesta escrita.
    function alterou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Ingresso: a pessoa só acrescenta a si mesma, mexendo apenas em
    // members/memberUids/updatedAt, e amparada por um convite verificável.
    function ingressoComConvite(hid) {
      let uid = request.auth.uid;
      let entrada = request.resource.data.members[uid];
      let convite = get(/databases/$(database)/documents/householdInvites/$(entrada.inviteCode)).data;
      return request.auth != null
          && !(uid in membros())
          && alterou(['members', 'memberUids', 'updatedAt'])
          && request.resource.data.members.diff(membros()).affectedKeys().hasOnly([uid])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && convite.householdId == hid
          && convite.expiresAt > request.time.toMillis()
          && entrada.role == convite.role
          && entrada.role in ['editor', 'viewer'];
    }

    // Saída: a pessoa remove apenas a si mesma.
    function saidaPropria() {
      let uid = request.auth.uid;
      return souMembro()
          && alterou(['members', 'memberUids', 'updatedAt'])
          && request.resource.data.members.diff(membros()).affectedKeys().hasOnly([uid])
          && !(uid in request.resource.data.members);
    }

    // Edição das listas: mexe no estado, nunca em quem participa.
    function edicaoDeListas() {
      return possoEditar()
          && alterou(['state', 'updatedAt', 'schemaVersion'])
          && request.resource.data.state is map;
    }

    match /households/{hid} {

      allow read: if souMembro();

      // Quem cria já nasce como dono e único membro.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid]
                    && request.resource.data.members[request.auth.uid].role == 'owner'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60;

      allow update: if edicaoDeListas()          // editar listas
                    || souDono()                 // dono administra membros e nome
                    || ingressoComConvite(hid)   // entrar por convite
                    || saidaPropria();           // sair por conta própria

      // Excluir a família inteira: só o dono.
      allow delete: if souDono();

      /* Presença: quem está com o app aberto agora. Todo membro lê;
         cada pessoa escreve apenas o próprio registro. */
      match /presence/{uid} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }
    }

    /* Convites.
       O código de 8 caracteres É o segredo: quem o tem, tem o convite. Por
       isso qualquer pessoa autenticada pode ler um convite específico — mas
       ninguém pode LISTAR a coleção, então não há como varrer códigos.
       Criar e revogar é privilégio do dono da família. */
    match /householdInvites/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.role in ['editor', 'viewer']
                    && request.resource.data.expiresAt is number
                    && request.resource.data.expiresAt <= request.time.toMillis() + 31536000000
                    && get(/databases/$(database)/documents/households/$(request.resource.data.householdId))
                         .data.members[request.auth.uid].role == 'owner';

      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/households/$(resource.data.householdId))
                         .data.members[request.auth.uid].role == 'owner';

      allow update: if false;
    }

    // Qualquer outra coleção é negada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
